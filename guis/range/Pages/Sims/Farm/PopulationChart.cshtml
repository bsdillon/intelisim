@page
@model Farm.PopulationChart

@{
    Layout = null;
}

<div
    id="population-chart"
    class="w-full"
    data-series="@Model.Json">
</div>

<script src="/vendor/d3/d3.v7.min.js"></script>
<script src="/js/farm-charts.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const chart = document.getElementById("population-chart");
        if (chart) renderFarmPopulation(chart);
    });
</script>
