@page
@model SimulationHistogram

@{
    Layout = null;
}

<div
    id="simulation-histogram"
    class="w-full"
    data-samples="@Model.Json">
</div>

<script src="/vendor/d3/d3.v7.min.js"></script>
<script src="/js/farm-charts.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const chart = document.getElementById("simulation-histogram");
        if (chart) renderFarmHistogram(chart);
    });
</script>
