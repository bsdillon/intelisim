@page
@model range.SheepFarm

@{
    // Layout = null;
    var current_parameters = @Model.FarmParams;
    var current_simulation = @Model.FarmSim;
    int seed = @Model.FarmSim.Seed;
    int trials = @Model.Trials;
}

<div x-data="setup_farm" class="flex flex-col items-center m-4">
    <div
        class="hero"
    >
        <div class="hero-overlay"></div>
        <div class="hero-content text-neutral-content text-center">
            <div class="max-w-md">
                <h1 class="mb-5 text-5xl font-bold">Sheep 🐑 Farm</h1>
            </div>
        </div>
    </div>

    <details class="collapse bg-base-100 border border-base-300 mb-4" name="sheep-farm-explanation">
        <summary class="collapse-title font-semibold">Explanation</summary>
        <div class="collapse-content text-sm bg-[#ddd]">

            <markdown>
                ## Stats We Want
                - final sheep population
                - final wolf population
                - maximum sheep population
                - maximum wolf population
                - time to extinction
                - whether coexistence occurred
                - average population
                - population variance

                ## UI - Sample of Farm statistics

                ┌────────────────┐ ┌────────────────┐ ┌────────────────┐
                │ 🐑 Coexistence │ │ 🐺 Extinction │ │ 🐑 Extinction │
                │ 37.4% │ │ 18.2 ticks │ │ 42.7 ticks │
                └────────────────┘ └────────────────┘ └────────────────┘
            </markdown>
        </div>


        @* TYPOGRAPHY TEST
    
    TODO: tailwind's typography would be very nice here, but the CDN i'm using doesn't seem to work with TW4.
    Will need to either match versions or vendorize the plugin.
     *@

        <template x-if="false">

            <details class="collapse bg-base-100 border border-base-300" name="my-accordion-det-1" open>
                <summary class="collapse-title font-semibold">Typography Test</summary>
                <div class="collapse-content text-sm bg-[#ddd]">

                    <article class="prose">
                        <h1>Garlic bread with cheese: What the science tells us</h1>
                        <p>
                            For years parents have espoused the health benefits of eating garlic bread with cheese to
                            their
                            children, with the food earning such an iconic status in our culture that kids will often
                            dress
                            up as warm, cheesy loaf for Halloween.
                        </p>
                        <p>
                            But a recent study shows that the celebrated appetizer may be linked to a series of rabies
                            cases
                            springing up around the country.
                        </p>
                        <!-- ... -->
                    </article>
                </div>
            </details>
        </template>
    </details>

    <div id="grid" x-data="{ wireframe: false }"
         :class="wireframe && 'wf-on'"
         class="grid grid-cols-4 grid-rows-4 sm:auto-rows-[180px] gap-4 grid-flow-dense">


        <div id="farm_controls" class="col-span-2 row-span-2">

            <div :class="views.controls.classname">
                <div class="card w-96 bg-base-100 shadow-sm">
                    <div class="card-body">
                        <div class="flex justify-between">
                            <h2 class="text-3xl font-bold">Controls</h2>
                        </div>
                        <div class="mt-6 gap-10 flex flex-row"
                             hx-page="/Sims/SheepFarm"
                             hx-target="#simulation-results"
                             hx-swap="innerHTML"
                        >
                            <button
                                hx-get
                                hx-page-handler="Reset"
                                class="btn btn-primary">Reset
                            </button>

                            <button
                                class="btn btn-primary"
                                hx-get
                                hx-trigger="click"
                                hx-page-handler="Play"
                            >
                                ▶ Play
                            </button>

                            <button hx-get
                                    hx-page-handler="Step" class="btn btn-primary">Step
                            </button>


                        </div>
                    </div>
                </div>
            </div>

            <div :class="views.model_params.classname">
                <div x-data="views.model_params" class="card w-96 bg-base-100 shadow-sm">
                    <div class="card-body">
                        <div class="flex justify-between">
                            <h2 class="text-3xl font-bold">Model Parameters</h2>
                        </div>
                        <div class="mt-6 gap-10 flex flex-row">
                            <form-control>
                                <label for="">Seed</label>
                                <input placeholder="1" value="@seed"/>
                            </form-control>
                            <button class="btn btn-primary">Reseed</button>
                        </div>

                        <div x-data="params" class="flex flex-col items-center justify-center">
                            @* <slider min="0" max="10"></slider> *@
                            <input x-data="grass_regrowth_time" type="range" :min="min" :max="max" :value="value"
                                   class="range range-neutral"/>

                            <input x-data="initial_sheep_population" type="range" :min="min" :max="max" :value="value"
                                   class="range text-blue-300 [--range-bg:orange] [--range-thumb:blue] [--range-fill:0]"/>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 w-96 shadow-sm">
                <div class="card-body">
                    <h2 class="card-title">Additional Options</h2>
                    <p>The following options are misc. like views, styles, debugging, wip gui components. <br>
                        Eventually, I'll move those that can be globally applied, to a sidebar.</p>
                    <details class="collapse bg-base-100 border border-base-300 mb-4"
                             name="other-options">
                        <summary class="collapse-title font-semibold">Gui Options</summary>
                        <div class="collapse-content text-sm bg-[#ddd]">
                            <label for="">Grid Wireframes</label>
                            <button @@click="wireframe = !wireframe"
                                    class="btn btn-accent text-white rounded">
                                <span x-show="wireframe">Hide</span>
                                <span x-show="!wireframe">Show</span>
                            </button>
                        </div>
                    </details>

                </div>
            </div>

        </div>

        <div class="p-4">

            <div id="simulation-results" class="m-4">
                <!-- Simulation results land here. -->
                ...
            </div>

        </div>

    </div>


</div>

<script src="/vendor/d3/d3.v7.min.js"></script>

<script>
    function setup_farm() {
        return {
            views: {
                controls: {
                    show: true,
                    animated: false,
                    get classname() {
                        return !!this.animated ? "aura aura-sm aura-dual text-orange-600 bg-yellow-200 duration-5000" : 'card text-orange-600 bg-base-100 w-96 shadow-sm';
                    }
                },
                model_params: {
                    animated: false,
                    get classname() {
                        return !!this.animated ? "aura aura-sm text-cyan-600 bg-yellow-200 duration-5000" : 'card bg-base-100  text-cyan-600  w-96 shadow-sm';
                    },
                    params: {
                        grass_regrowth_time: {min: 0, max: 100, value: 25},
                        initial_sheep_population: {min: 0, max: 100, value: 50}
                    }
                }
            }
        }
    }
</script>

<style>
    [x-cloak] {
        display: none !important
    }

    #grid.wf-on > * {
        outline: 2px dotted #60a5fa;
    }
</style>



