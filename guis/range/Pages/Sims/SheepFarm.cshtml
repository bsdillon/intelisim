@page
@model range.SheepFarm

@{
    // Layout = null;
    var current_parameters = @Model.FarmParams;
    var current_simulation = @Model.FarmSim;
    int seed = @Model.FarmSim.Seed;
}

<div x-data="setup_farm" class="flex flex-col items-center m-4">
    @* style="background-image: url(https://img.daisyui.com/images/stock/photo-1507358522600-9f71e620c44e.webp);" *@
    <div
        class="hero"
    >
        <div class="hero-overlay"></div>
        <div class="hero-content text-neutral-content text-center">
            <div class="max-w-md">
                <h1 class="mb-5 text-5xl font-bold">Sheep 🐑 Farm</h1>
            </div>
        </div>
    </div>

    <details class="collapse bg-base-100 border border-base-300" name="sheep-farm-explanation">
        <summary class="collapse-title font-semibold">Explanation</summary>
        <div class="collapse-content text-sm bg-[#ddd]">

            <markdown>
                ## Stats We Want
                - final sheep population
                - final wolf population
                - maximum sheep population
                - maximum wolf population
                - time to extinction
                - whether coexistence occurred
                - average population
                - population variance

                ## UI - Sample of Farm statistics

                ┌────────────────┐ ┌────────────────┐ ┌────────────────┐
                │ 🐑 Coexistence │ │ 🐺 Extinction │ │ 🐑 Extinction │
                │ 37.4% │ │ 18.2 ticks │ │ 42.7 ticks │
                └────────────────┘ └────────────────┘ └────────────────┘
            </markdown>
        </div>
    </details>

    <div id="grid" class="grid lg:grid-cols-2 grid-flow-col gap-2">

        <div id="farm_controls" class="grid-row-2">

            <div :class="views.controls.classname">
                <div class="card w-96 bg-base-100 shadow-sm">
                    <div class="card-body">
                        <div class="flex justify-between">
                            <h2 class="text-3xl font-bold">Controls</h2>
                        </div>
                        <div class="mt-6 gap-10 flex flex-row"
                             hx-page="/Sims/SheepFarm"
                        >
                            <button
                                hx-get
                                hx-page-handler="Reset"
                                class="btn btn-primary">Reset
                            </button>

                            <button hx-get
                                    hx-page-handler="Play" class="btn btn-primary">Play
                            </button>
                            <button hx-get
                                    hx-page-handler="Step" class="btn btn-primary">Step
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div :class="views.model_params.classname">
                <div x-data="views.model_params" class="card w-96 bg-base-100 shadow-sm">
                    <div class="card-body">
                        <div class="flex justify-between">
                            <h2 class="text-3xl font-bold">Model Parameters</h2>
                        </div>
                        <div class="mt-6 gap-10 flex flex-row">
                            <form-control>
                                <label for="">Seed</label>
                                <input placeholder="1" value="@seed"/>
                            </form-control>
                            <button class="btn btn-primary">Reseed</button>
                        </div>

                        <div x-data="params" class="flex flex-col items-center justify-center">
                            @* <slider min="0" max="10"></slider> *@
                            <input x-data="grass_regrowth_time" type="range" :min="min" :max="max" :value="value"
                                   class="range range-neutral"/>

                            <input x-data="initial_sheep_population" type="range" :min="min" :max="max" :value="value"
                                   class="range text-blue-300 [--range-bg:orange] [--range-thumb:blue] [--range-fill:0]"/>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="card bg-base-100 shadow">
            <div class="card-body">
                <h2 class="card-title">Population over time</h2>
                <div id="population-chart"></div>
            </div>
        </div>

        @* STATS *@
        <div id="farm_stats">
            <partial name="Farm/_FarmStats"></partial>
        </div>

    </div>


</div>

<script src="/vendor/d3/d3.v7.min.js"></script>

<script>

    const populationData = [
        {tick: 0, sheep: 100, wolves: 20},
        {tick: 1, sheep: 100, wolves: 20},
        {tick: 2, sheep: 80, wolves: 20},
        {tick: 3, sheep: 60, wolves: 40},
        {tick: 4, sheep: 20, wolves: 60},
        {tick: 5, sheep: 0, wolves: 87},
        {tick: 6, sheep: 0, wolves: 87},
        {tick: 7, sheep: 0, wolves: 87},
        {tick: 8, sheep: 0, wolves: 87},
        {tick: 9, sheep: 0, wolves: 87},
        {tick: 10, sheep: 0, wolves: 87}
    ];

    const width = 800;
    const height = 400;

    const margin = {
        top: 20,
        right: 30,
        bottom: 45,
        left: 55
    };

    const svg = d3.select("#population-chart")
        .append("svg")
        .attr("viewBox", `0 0 ${width} ${height}`)
        .attr("width", "100%")
        .attr("height", "auto");

    const x = d3.scaleLinear()
        .domain(d3.extent(populationData, d => d.tick))
        .range([margin.left, width - margin.right]);

    const y = d3.scaleLinear()
        .domain([0, d3.max(populationData, d =>
            Math.max(d.sheep, d.wolves)
        )])
        .nice()
        .range([height - margin.bottom, margin.top]);

    svg.append("g")
        .attr("transform", `translate(0,${height - margin.bottom})`)
        .call(d3.axisBottom(x).ticks(10));

    svg.append("g")
        .attr("transform", `translate(${margin.left},0)`)
        .call(d3.axisLeft(y));

    const line = d3.line()
        .x(d => x(d.tick))
        .y(d => y(d.value));

    const sheep = populationData.map(d => ({
        tick: d.tick,
        value: d.sheep
    }));

    const wolves = populationData.map(d => ({
        tick: d.tick,
        value: d.wolves
    }));

    svg.append("path")
        .datum(sheep)
        .attr("fill", "none")
        .attr("stroke", "steelblue")
        .attr("stroke-width", 2)
        .attr("d", line);

    svg.append("path")
        .datum(wolves)
        .attr("fill", "none")
        .attr("stroke", "darkred")
        .attr("stroke-width", 2)
        .attr("d", line);

    // Labels
    svg.append("text")
        .attr("x", width / 2)
        .attr("y", height - 5)
        .attr("text-anchor", "middle")
        .text("Tick");

    svg.append("text")
        .attr("transform", "rotate(-90)")
        .attr("x", -(height / 2))
        .attr("y", 15)
        .attr("text-anchor", "middle")
        .text("Population");
</script>
<script>
    function setup_farm() {
        return {
            views: {
                controls: {
                    show: true,
                    animated: false,
                    get classname() {
                        return !!this.animated ? "aura aura-sm aura-dual text-orange-600 bg-yellow-200 duration-5000" : 'card text-orange-600 bg-base-100 w-96 shadow-sm';
                    }
                },
                model_params: {
                    animated: false,
                    get classname() {
                        return !!this.animated ? "aura aura-sm text-cyan-600 bg-yellow-200 duration-5000" : 'card bg-base-100  text-cyan-600  w-96 shadow-sm';
                    },
                    params: {
                        grass_regrowth_time: {min: 0, max: 100, value: 25},
                        initial_sheep_population: {min: 0, max: 100, value: 50}
                    }
                }
            }
        }
    }
</script>