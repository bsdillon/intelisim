@page
@using range.Pages.Shared.Components
@model IndexModel
@{
    ViewData["Title"] = "Home page";
    var dict = new Dictionary<string, string>()
    {
        ["Home"] = "/",
        ["Lab 01"] = "/Lab01",
        ["Run History"] = "/Sims/RunHistory",
    };

    // reusing navbarlink here.  Ideally, I'd use pocketbase to load link trees and use a separate model.
    var links = dict.Aggregate(new List<NavbarLink>(), (navbarLinks, pair) =>
    {
        navbarLinks.Add(new NavbarLink { name = pair.Key, href = pair.Value });
        return navbarLinks;
    }).ToArray();
}

<div class="text-center center">
    <h1 class="display-4">Welcome to Intelisim!</h1>

    <stack>

        <div>
            <island url="/profile/avatar" event="Revealed">
                <div class="alert alert-info d-flex justify-content-center vertical-align-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </island>
        </div>

        <ul>
            <h1>Pick a Lab:</h1>

            <stack>
                @foreach (var link in links)
                {
                    <link-button href="@link.href" class="btn btn-primary">
                        @link.name
                    </link-button>
                }
            </stack>
        </ul>
    </stack>

    @* <script> *@
    @*     function setup_labs() { *@
    @*         return { *@
    @*             labs: [ *@
    @*                 {name: "Lab 01", link: "Lab01"}, *@
    @*                 {name: "Lab 2", link: "Lab02"} *@
    @*             ] *@
    @*         } *@
    @*     } *@
    @* </script> *@
</div>
